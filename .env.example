# Скопируй в .env и заполни своими значениями. .env в git не попадает.
# Права: chmod 600 .env

# Токен бота от @BotFather
BOT_TOKEN=

# ID админа в Telegram (число)
ADMIN_TG_ID=

# Базовый URL панели 3x-ui вместе с путём (обязательно абсолютный)
XUI_URL=https://panel.example.com/vpn-panel/

# Публичный базовый URL, по которому выдаются подписки
SUBSCRIPTION_BASE_URL=https://vpn.example.com/subscriptions

# API-токен 3x-ui (Settings -> API)
XRAY_API_TOKEN=
